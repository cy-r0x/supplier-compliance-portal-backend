generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  DISTRIBUTOR
  SUPPLIER
}

enum ProductStatus {
  PENDING
  SUBMITTED
  REJECTED
  APPROVED
}

enum NotificationType {
  REQUEST_CREATED
  REQUEST_SUBMITTED
  REQUEST_APPROVED
  REQUEST_REJECTED
  REQUEST_MESSAGE
  REQUEST_DELETED
}

model User {
  id       String  @id @default(uuid())
  name     String
  email    String  @unique
  password String
  role     Role
  photo    String?

  createdById  String?
  createdBy    User?   @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdUsers User[]  @relation("UserCreatedBy")

  distributorId String?
  distributor   User?   @relation("DistributorSuppliers", fields: [distributorId], references: [id])
  suppliers     User[]  @relation("DistributorSuppliers")

  requestedProducts Product[] @relation("ProductDistributor")
  suppliedProducts  Product[] @relation("ProductSupplier")

  createdNotifications  Notification[] @relation("NotificationCreator")
  receivedNotifications Notification[] @relation("NotificationReceiver")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([distributorId])
  @@map("users")
}

model Product {
  id              String        @id @default(uuid())
  name            String
  sku             String?       @unique
  photo           String?
  price           Decimal?      @db.Decimal(12, 2)
  status          ProductStatus @default(PENDING)
  rejectionReason String?
  publicSlug      String        @unique @default(uuid())
  deletedAt       DateTime?

  distributorId String
  distributor   User   @relation("ProductDistributor", fields: [distributorId], references: [id])

  supplierId String
  supplier   User   @relation("ProductSupplier", fields: [supplierId], references: [id])

  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([distributorId])
  @@index([supplierId])
  @@map("products")
}

model Notification {
  id      String           @id @default(uuid())
  type    NotificationType
  title   String
  message String
  read    Boolean          @default(false)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  creatorId String
  creator   User   @relation("NotificationCreator", fields: [creatorId], references: [id])

  receiverId String
  receiver   User   @relation("NotificationReceiver", fields: [receiverId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([receiverId, read])
  @@index([productId])
  @@map("notifications")
}
