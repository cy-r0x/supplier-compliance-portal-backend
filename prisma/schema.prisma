generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  USER
  SUPPLIER
}

enum OrganizationMemberRole {
  MANAGER
  MEMBER
}

enum ProductStatus {
  PENDING
  SUBMITTED
  REJECTED
  APPROVED
}

enum DocumentType {
  TEST_REPORT
  DECLARATION_OF_CONFORMITY
  MANUAL_OR_INSTRUCTIONS
  CERTIFICATE
  PRODUCT_IMAGE
  SAFETY_IMAGE
  REGULATORY_DOCUMENT
  OTHER
}

enum FieldType {
  SAFETY_NOTICE_TEXT
  WARNING_TEXT
  AGE_GRADING
  MATERIAL_INFORMATION
  USAGE_RESTRICTIONS
  SAFETY_INSTRUCTIONS
  ADDITIONAL_NOTES
  OTHER
}

enum RequirementLevel {
  REQUIRED
  OPTIONAL
}

enum DocumentVisibility {
  PUBLIC
  PRIVATE
}

enum NotificationType {
  REQUEST_CREATED
  REQUEST_SUBMITTED
  REQUEST_APPROVED
  REQUEST_REJECTED
  REQUEST_MESSAGE
  REQUEST_DELETED
  REQUEST_REQUIREMENTS_UPDATED
}

model User {
  id       String  @id @default(uuid())
  name     String
  email    String  @unique
  password String
  role     Role
  photo    String?

  createdById  String?
  createdBy    User?  @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdUsers User[] @relation("UserCreatedBy")

  organizationMembership OrganizationMember?

  createdProductRequests ProductRequest[] @relation("ProductCreatedBy")
  suppliedProducts       ProductRequest[] @relation("ProductSupplier")

  createdNotifications  Notification[]   @relation("NotificationCreator")
  receivedNotifications Notification[]   @relation("NotificationReceiver")
  sentMessages          ProductMessage[] @relation("MessageSender")
  refreshTokens         RefreshToken[]
  settings              UserSettings?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([createdById])
  @@map("users")
}

/// Personal preferences only (org-level settings live on OrganizationSettings).
model UserSettings {
  id String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_settings")
}

model Organization {
  id   String @id @default(uuid())
  name String

  members             OrganizationMember[]
  settings            OrganizationSettings?
  productRequests     ProductRequest[]
  requirementTemplates RequirementTemplate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name])
  @@map("organizations")
}

model OrganizationMember {
  id String @id @default(uuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// One membership per user globally.
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role OrganizationMemberRole

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, role])
  @@map("organization_members")
}

model OrganizationSettings {
  id String @id @default(uuid())

  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// When true, valid supplier submit auto-sets request to APPROVED
  autoApproveProductRequests Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("organization_settings")
}

model RefreshToken {
  id                String    @id @default(uuid())
  tokenHash         String    @unique
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Compliance product request (organization manager → supplier)
model ProductRequest {
  id              String        @id @default(uuid())
  name            String
  sku             String?
  photo           String?
  price           Decimal?      @db.Decimal(12, 2)
  status          ProductStatus @default(PENDING)
  rejectionReason String?
  publicSlug      String        @unique @default(uuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  createdById String?
  createdBy   User?   @relation("ProductCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  supplierId String
  supplier   User   @relation("ProductSupplier", fields: [supplierId], references: [id], onDelete: Restrict)

  templateId String
  template   RequirementTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  notifications   Notification[]
  documentAnswers ProductDocumentAnswer[]
  fieldAnswers    ProductFieldAnswer[]
  messages        ProductMessage[]

  isDeleted Boolean @default(false)

  submittedAt DateTime?
  reviewedAt  DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([supplierId, isDeleted, status])
  @@index([organizationId, isDeleted, status])
  @@index([isDeleted, deletedAt])
  @@index([isDeleted, status, createdAt])
  @@index([status])
  @@index([templateId])
  @@index([createdById])
  @@map("product_requests")
}

model RequirementTemplate {
  id   String @id @default(uuid())
  name String

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  documents RequirementTemplateDocument[]
  fields    RequirementTemplateField[]

  productRequests ProductRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("requirement_templates")
}

model RequirementTemplateDocument {
  id String @id @default(uuid())

  templateId String
  template   RequirementTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  type      DocumentType
  customKey String       @default("")
  label     String?

  level      RequirementLevel
  visibility DocumentVisibility

  answers ProductDocumentAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([templateId, type, customKey])
  @@index([templateId])
  @@map("requirement_template_documents")
}

model RequirementTemplateField {
  id String @id @default(uuid())

  templateId String
  template   RequirementTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  fieldType  FieldType
  customKey  String             @default("")
  label      String?
  level      RequirementLevel
  visibility DocumentVisibility

  answers ProductFieldAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([templateId, fieldType, customKey])
  @@index([templateId])
  @@map("requirement_template_fields")
}

/// Per-product document upload keyed to a template document row.
model ProductDocumentAnswer {
  id String @id @default(uuid())

  productRequestId String
  productRequest   ProductRequest @relation(fields: [productRequestId], references: [id], onDelete: Cascade)

  templateDocumentId String
  templateDocument   RequirementTemplateDocument @relation(fields: [templateDocumentId], references: [id], onDelete: Restrict)

  fileUrl  String
  fileName String?

  uploadedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([productRequestId, templateDocumentId])
  @@index([templateDocumentId])
  @@map("product_document_answers")
}

/// Per-product field value keyed to a template field row.
model ProductFieldAnswer {
  id String @id @default(uuid())

  productRequestId String
  productRequest   ProductRequest @relation(fields: [productRequestId], references: [id], onDelete: Cascade)

  templateFieldId String
  templateField   RequirementTemplateField @relation(fields: [templateFieldId], references: [id], onDelete: Restrict)

  value String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productRequestId, templateFieldId])
  @@index([templateFieldId])
  @@map("product_field_answers")
}

model ProductMessage {
  id String @id @default(uuid())

  productRequestId String
  productRequest   ProductRequest @relation(fields: [productRequestId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  body String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productRequestId, createdAt])
  @@index([senderId])
  @@map("product_messages")
}

model Notification {
  id      String           @id @default(uuid())
  type    NotificationType
  title   String
  message String
  isRead  Boolean          @default(false)

  productRequestId String?
  productRequest   ProductRequest? @relation(fields: [productRequestId], references: [id], onDelete: SetNull)

  creatorId String
  creator   User   @relation("NotificationCreator", fields: [creatorId], references: [id], onDelete: Restrict)

  receiverId String
  receiver   User   @relation("NotificationReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([receiverId, isRead, createdAt])
  @@index([receiverId, createdAt])
  @@index([productRequestId])
  @@index([creatorId])
  @@map("notifications")
}
